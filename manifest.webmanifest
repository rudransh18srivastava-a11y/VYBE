{
  "name": "Vwatcher — Universal Video Player",
  "short_name": "Vwatcher",
  "description": "A private, universal video player that runs entirely in your browser.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0b0d12",
  "theme_color": "#0b0d12",
  "icons": [
    { "src": "icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any maskable" }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "video/*": [".mp4", ".webm", ".mkv", ".mov", ".m4v", ".ogv", ".3gp", ".ts", ".mpg", ".mpeg"],
        "audio/*": [".mp3", ".m4a", ".aac", ".wav", ".flac", ".opus"]
      }
    }
  ]
}
